# Copy this file to .env and add your hackathon credentials. Never commit .env.
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Pick a warm, clear ElevenLabs voice from your account.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Temporary AI companion implementation. It is isolated in companion.py so it
# can be replaced with the team's custom reply algorithm later.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MEMORY_MODEL=gpt-5-mini

# Supabase shared transaction-pooler URL. Leave unset to use local JSONL files.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Supabase Auth settings from Project Settings -> API. The publishable key is
# designed for client-facing auth flows, but RSpace sends it from the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional secondary memory index. Supabase/PostgreSQL remains the source of truth.
ELASTICSEARCH_URL=https://your-elasticsearch-endpoint
ELASTIC_API_KEY=your_elasticsearch_api_key

# Local memory engine. "hashing" requires no extra dependency. For stronger
# local semantic search, install requirements-local-embeddings.txt and use
# "sentence-transformers". Embeddings stay local; extraction uses the OpenAI model above.
RSPACE_EMBEDDING_BACKEND=hashing
RSPACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
